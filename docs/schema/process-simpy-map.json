{
  "PROCESS_BINDING_META":{
    "meta":{
      "schema_name":"PROCESS_BINDING_META",
      "schema_version":"0.1.0-draft",
      "scope":"simpy_binding_only",
      "default_apply_mode":"provisional",
      "compile_target":"simpy",
      "design_principles":[
        "reference_process_definition_intent",
        "do_not_expose_all_simpy_internals",
        "source_vs_derived_separation",
        "policy_ref_preferred_for_advanced_options"
      ]
    },
    "field_contract":{
      "process_definition_ref":{
        "type":"object",
        "required":true
      },
      "graph_binding":{
        "type":"object",
        "required":true
      },
      "item_binding":{
        "type":"object",
        "required":true
      },
      "resource_binding":{
        "type":"object",
        "required":true
      },
      "time_binding":{
        "type":"object",
        "required":true
      },
      "transition_binding":{
        "type":"object",
        "required":true
      },
      "queue_binding":{
        "type":"object",
        "required":true
      },
      "quality_binding":{
        "type":"object",
        "required":false
      },
      "calendar_binding":{
        "type":"object",
        "required":false
      },
      "validation_gates":{
        "type":"array",
        "required":true
      },
      "compiler_defaults":{
        "type":"object",
        "required":true
      }
    },
    "template":{
      "process_definition_ref":{
        "schema_name":"PROCESS_DEFINITION_INTENT",
        "schema_version":"0.1.0-draft",
        "required_validation_statuses":[
          "usable",
          "provisional"
        ],
        "required_top_level_keys":[
          "product_context",
          "process_graph",
          "derived_fields_plan",
          "validation_report"
        ]
      },
      "graph_binding":{
        "step_collection_path":"process_graph.steps[]",
        "step_id_path":"step_no",
        "step_id_type":"string",
        "graph_product_id_path":"process_graph.product_id",
        "graph_status_path":"process_graph.graph_completeness_status",
        "next_step_collection_path":"next_steps[]",
        "next_step_id_path":"step_no",
        "allowed_flow_types":[
          "sequential",
          "parallel",
          "merge",
          "split"
        ],
        "parallel_group_path":"parallel_group_id",
        "join_condition_path":"join_condition",
        "production_type_path":"production_type"
      },
      "item_binding":{
        "input_item_id_path":"input_item_id",
        "output_item_id_path":"output_item_id",
        "input_qty_per_path":"input_qty_per",
        "unit_resolution_order":[
          "product_context.unit",
          "normalized_entities.items[].unit",
          "fallback_unit"
        ],
        "fallback_unit":"m"
      },
      "resource_binding":{
        "primary_resource_key_path":"equipment_group",
        "resource_master_reference_path":"equipments[].group_id",
        "resource_entity_type":"simpy.Resource",
        "capacity_resolution_order":[
          "equipments[].capacity",
          "group_capacity_profile_ref",
          "default_resource_capacity"
        ],
        "default_resource_capacity":1,
        "missing_resource_policy":"block_on_master_missing",
        "reference_status_path":"reference_status.equipment_group_ref"
      },
      "time_binding":{
        "std_speed_path":"std_speed",
        "std_time_per_path":"std_time_per",
        "setup_time_resolution_order":[
          "recipe_context.setup_time",
          "recipes[].setup_time",
          "fallback_setup_time"
        ],
        "fallback_setup_time":0,
        "processing_time_resolution_order":[
          "std_time_per",
          "derive_from_std_speed",
          "recipe_speed_fixed",
          "recipe_speed_variable_mean",
          "fallback_processing_time"
        ],
        "recipe_speed_fixed_path":"recipes[].speed.fixed",
        "recipe_speed_variable_min_path":"recipes[].speed.variable.min",
        "recipe_speed_variable_max_path":"recipes[].speed.variable.max",
        "derive_rules":[
          {
            "target_path":"std_time_per",
            "derive_from":[
              "std_speed"
            ],
            "formula_id":"inverse_of_std_speed",
            "rounding_rule":"6_decimal"
          }
        ],
        "fallback_processing_time":null
      },
      "transition_binding":{
        "transition_collection_path":"next_steps[]",
        "transition_step_no_path":"step_no",
        "transition_condition_path":"condition",
        "empty_condition_means":"unconditional",
        "missing_next_step_policy":"allow_terminal_if_explicitly_marked_otherwise_block"
      },
      "queue_binding":{
        "create_input_queue_per_step":true,
        "queue_id_pattern":"Q{product_id}_{step_no}",
        "queue_discipline":"FIFO",
        "queue_capacity_policy":"unbounded_if_missing",
        "partial_transfer_allowed":false,
        "wip_tracking_enabled":true
      },
      "quality_binding":{
        "enable_quality_logic":false,
        "defect_rate_reference_paths":[
          "quality_standards[].defect_types[].defect_rate"
        ],
        "defect_missing_policy":"assume_zero_provisional",
        "rework_route_path":null,
        "scrap_route_path":null
      },
      "calendar_binding":{
        "use_workforce_calendar":false,
        "shift_source_path":"workforce.shifts[]",
        "assignment_source_path":"workforce.assignments[]",
        "cross_midnight_flag_path":"workforce.shifts[].cross_midnight_allowed",
        "next_day_offset_path":"workforce.shifts[].next_day_offset",
        "calendar_missing_policy":"24x7_if_disabled"
      },
      "validation_gates":[
        {
          "gate_id":"step_no_normalized_to_string",
          "severity":"critical",
          "required":true
        },
        {
          "gate_id":"next_step_no_normalized_to_string",
          "severity":"critical",
          "required":true
        },
        {
          "gate_id":"std_time_per_recomputed_from_std_speed",
          "severity":"high",
          "required":true
        },
        {
          "gate_id":"equipment_group_reference_resolved",
          "severity":"critical",
          "required":true
        },
        {
          "gate_id":"no_dangling_next_step_reference",
          "severity":"critical",
          "required":true
        },
        {
          "gate_id":"graph_completeness_reviewed",
          "severity":"high",
          "required":true
        },
        {
          "gate_id":"recipe_coverage_reviewed",
          "severity":"medium",
          "required":false
        },
        {
          "gate_id":"workforce_calendar_reviewed",
          "severity":"medium",
          "required":false
        }
      ],
      "compiler_defaults":{
        "step_entity_class":"ProcessStep",
        "resource_entity_class":"ResourcePool",
        "transition_entity_class":"StepTransition",
        "event_clock_source":"runtime_meta.time_control",
        "compile_mode":"strict_with_provisional_support",
        "block_on_critical_validation_error":true
      }
    }
  },
  "SIMPY_RUNTIME_META":{
    "_meta":{
      "schema_name":"SIMPY_RUNTIME_META",
      "schema_version":"0.1.0-draft",
      "scope":"simpy_runtime_only",
      "default_apply_mode":"provisional",
      "source_compatibility":[
        "simulation_configs[]"
      ]
    },
    "field_contract":{
      "runtime_profile_header":{
        "type":"object",
        "required":true
      },
      "time_control":{
        "type":"object",
        "required":true
      },
      "execution_mode":{
        "type":"object",
        "required":true
      },
      "scenario_toggles":{
        "type":"object",
        "required":true
      },
      "policy_refs":{
        "type":"object",
        "required":false
      },
      "stochastic_defaults":{
        "type":"object",
        "required":false
      },
      "output_control":{
        "type":"object",
        "required":true
      },
      "validation_status":{
        "type":"object",
        "required":true
      }
    },
    "template":{
      "runtime_profile_header":{
        "profile_id":null,
        "profile_name":null,
        "schema_status":"provisional",
        "source_config_path_hint":"simulation_configs[]"
      },
      "time_control":{
        "time_unit":"day",
        "base_time_granularity":"minute",
        "start_date":null,
        "duration_days":30,
        "warmup_period":0,
        "replication_count":1,
        "random_seed":42
      },
      "execution_mode":{
        "speed_mode":"fixed",
        "deterministic_mode":true,
        "logging_level":"standard"
      },
      "scenario_toggles":{
        "enable_breakdown":false,
        "enable_preventive_maintenance":false,
        "enable_defect_generation":false,
        "enable_rework_flow":false,
        "enable_shift_calendar":false
      },
      "policy_refs":{
        "processing_time_policy_ref":"speed_to_time_v1",
        "queue_policy_ref":"fifo_default_v1",
        "resource_request_policy_ref":"single_primary_resource_v1",
        "batching_policy_ref":"production_type_based_v1",
        "calendar_policy_ref":"disabled_24x7_v1"
      },
      "stochastic_defaults":{
        "distribution_mode":"deterministic",
        "default_distribution_family":null,
        "use_common_random_numbers":false
      },
      "output_control":{
        "collect_event_log":true,
        "collect_resource_log":true,
        "collect_wip_snapshot":true,
        "snapshot_interval":60,
        "snapshot_interval_unit":"minute"
      },
      "validation_status":{
        "runtime_profile_readiness":"provisional",
        "missing_runtime_fields":[
          
        ],
        "blocked_runtime_fields":[
          
        ],
        "notes":[
          
        ]
      },
      "out_of_scope_fields":[
        "objective",
        "due_date",
        "priority",
        "target_qty"
      ]
    }
  },
  "SIMPY_COMPILATION_INTENT":{
    "_meta":{
      "schema_name":"SIMPY_COMPILATION_INTENT",
      "schema_version":"0.1.0-draft",
      "scope":"compile_request_only",
      "default_apply_mode":"provisional"
    },
    "template":{
      "compile_request_id":null,
      "process_definition_ref":{
        "intent_id":null,
        "schema_name":"PROCESS_DEFINITION_INTENT",
        "schema_version":"0.1.0-draft"
      },
      "binding_meta_ref":{
        "schema_name":"PROCESS_BINDING_META",
        "schema_version":"0.1.0-draft"
      },
      "runtime_meta_ref":{
        "profile_id":null,
        "schema_name":"SIMPY_RUNTIME_META",
        "schema_version":"0.1.0-draft"
      },
      "compile_policies":{
        "allow_provisional_steps":true,
        "allow_provisional_recipe_scope":true,
        "auto_recompute_derived_fields":true,
        "block_on_critical_reference_error":true,
        "block_on_dangling_step_reference":true,
        "use_default_capacity_if_missing":false
      },
      "compile_result_contract":{
        "return_compiled_process_graph":true,
        "return_resource_plan":true,
        "return_validation_report":true,
        "return_runtime_profile_echo":true
      },
      "apply_mode":"provisional"
    }
  }
}