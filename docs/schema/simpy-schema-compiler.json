{
  "COMPILER_MAPPING_RULE":{
    "_meta":{
      "schema_name":"COMPILER_MAPPING_RULE",
      "schema_version":"0.1.0-draft",
      "scope":"simpy_compiler_mapping_only",
      "default_apply_mode":"provisional",
      "compile_target":"simpy",
      "design_principles":[
        "path_aware_resolution",
        "strict_on_graph_and_reference_integrity",
        "derived_field_recomputation_first",
        "provisional_support_with_explicit_gate"
      ]
    },
    "compiler_input_contract":{
      "required_inputs":[
        "PROCESS_DEFINITION_INTENT",
        "PROCESS_BINDING_META",
        "SIMPY_RUNTIME_META"
      ],
      "process_definition_required_keys":[
        "intent_header",
        "product_context",
        "process_graph",
        "derived_fields_plan",
        "validation_report",
        "apply_mode",
        "compile_target"
      ],
      "binding_required_sections":[
        "graph_binding",
        "item_binding",
        "resource_binding",
        "time_binding",
        "transition_binding",
        "queue_binding",
        "validation_gates",
        "compiler_defaults"
      ],
      "runtime_required_sections":[
        "time_control",
        "execution_mode",
        "scenario_toggles",
        "output_control",
        "validation_status"
      ]
    },
    "path_resolution_rules":{
      "step_collection_path":"PROCESS_DEFINITION_INTENT.process_graph.steps[]",
      "step_id_path":"step_no",
      "step_id_type":"string",
      "transition_collection_path":"next_steps[]",
      "transition_target_step_path":"step_no",
      "equipment_group_path":"equipment_group",
      "input_item_path":"input_item_id",
      "output_item_path":"output_item_id",
      "production_type_path":"production_type",
      "flow_type_path":"flow_type",
      "parallel_group_path":"parallel_group_id",
      "join_condition_path":"join_condition",
      "condition_path":"next_steps[].condition",
      "reference_status_path":"reference_status",
      "graph_status_path":"PROCESS_DEFINITION_INTENT.process_graph.graph_completeness_status"
    },
    "normalization_rules":{
      "step_no_rule":"must_be_string",
      "next_step_no_rule":"must_be_string",
      "empty_condition_rule":"treat_as_unconditional",
      "blank_parallel_group_rule":"treat_as_no_parallel_group",
      "blank_join_condition_rule":"treat_as_no_join_condition",
      "unit_resolution_order":[
        "PROCESS_DEFINITION_INTENT.product_context.unit",
        "PROCESS_BINDING_META.template.item_binding.fallback_unit"
      ]
    },
    "derived_value_rules":{
      "processing_time_resolution_order":[
        "step.std_time_per_if_valid",
        "derive_from_step.std_speed",
        "recipe_context.setup_time_plus_speed_policy",
        "block_if_unresolved"
      ],
      "std_time_per_rule":{
        "value_role":"derived",
        "recompute_if_present":true,
        "derive_from":[
          "step.std_speed"
        ],
        "formula_id":"inverse_of_std_speed",
        "rounding_rule":"6_decimal"
      },
      "setup_time_rule":{
        "resolution_order":[
          "PROCESS_DEFINITION_INTENT.recipe_context.setup_time",
          "PROCESS_BINDING_META.template.time_binding.fallback_setup_time"
        ],
        "default_value":0
      }
    },
    "resource_resolution_rules":{
      "primary_resource_key":"equipment_group",
      "resource_master_lookup_path":"equipments[].group_id",
      "lookup_mode":"group_match",
      "capacity_resolution_order":[
        "equipment_master.capacity",
        "PROCESS_BINDING_META.template.resource_binding.default_resource_capacity"
      ],
      "default_resource_capacity":1,
      "missing_resource_policy":"block",
      "provisional_resource_policy":"allow_only_if_explicit_user_approval",
      "example_known_issue_handling":{
        "GRP-DRAW":{
          "observed_issue":"master_missing",
          "default_action":"block_compile_or_require_provisional_master"
        }
      }
    },
    "graph_validation_rules":{
      "require_non_empty_steps":true,
      "require_unique_step_ids":true,
      "require_all_next_steps_resolved":true,
      "allow_terminal_step_without_next_steps":true,
      "require_parallel_group_consistency":true,
      "require_join_condition_if_merge_detected":false,
      "graph_completeness_status_policy":{
        "complete":"compile_allowed",
        "provisional":"compile_allowed_with_warning",
        "incomplete":"compile_blocked",
        "blocked":"compile_blocked"
      },
      "known_issue_patterns":[
        {
          "pattern_id":"dangling_next_step",
          "example":"3a -> 4 but step 4 missing",
          "default_action":"block"
        },
        {
          "pattern_id":"parallel_branch_missing",
          "example":"3-core product but only 3a exists without 3b/3c",
          "default_action":"block_or_require_provisional_steps"
        },
        {
          "pattern_id":"missing_join_or_downstream_finish",
          "example":"join/cabling/sheathing steps absent",
          "default_action":"block_or_mark_graph_incomplete"
        }
      ]
    },
    "queue_compilation_rules":{
      "create_input_queue_per_step":true,
      "queue_id_format":"Q::{product_id}::{step_no}",
      "queue_discipline":"FIFO",
      "queue_capacity_policy":"unbounded_if_missing",
      "allow_partial_transfer":false,
      "wip_tracking_enabled":true,
      "schema_status":"provisional"
    },
    "transition_compilation_rules":{
      "sequential_rule":"single successor unconditional transition",
      "parallel_rule":"fork token into same parallel_group_id successors",
      "merge_rule":"wait_for_join_condition_or_all_required_inputs",
      "split_rule":"branch by condition or configured ratio",
      "condition_interpretation":{
        "empty_string":"always_true",
        "non_empty_string":"application_defined_expression"
      }
    },
    "recipe_selection_rules":{
      "selection_order":[
        "exact_equipment_and_product_match",
        "group_level_process_match",
        "product_process_fallback",
        "no_recipe"
      ],
      "recipe_scope_field":"recipe_scope",
      "missing_recipe_policy":"allow_if_process_time_resolved_else_block",
      "process_id_alignment_policy":{
        "allow_process_group_mapping":true,
        "example":"PROC-INS-A may map to PROC-INS via process_group_id"
      },
      "schema_status":"provisional"
    },
    "calendar_compilation_rules":{
      "enabled_only_if_runtime_toggle_true":true,
      "shift_time_format":"HH:MM",
      "special_case_24_00_policy":"normalize_to_00_00_with_next_day_offset",
      "cross_midnight_fields":[
        "cross_midnight_allowed",
        "next_day_offset"
      ],
      "missing_calendar_policy":"ignore_if_runtime_disabled_else_warn_or_block",
      "schema_status":"provisional"
    },
    "quality_compilation_rules":{
      "enabled_only_if_runtime_toggle_true":true,
      "defect_rate_lookup_path":"quality_standards[].defect_types[].defect_rate",
      "defect_rate_cast_rule":"cast_to_float",
      "defect_missing_policy":"assume_zero_provisional",
      "rework_route_policy":"not_defined_in_v1",
      "schema_status":"provisional"
    },
    "compile_blocking_rules":[
      {
        "rule_id":"BLOCK_MISSING_RESOURCE_MASTER",
        "condition":"resource_resolution_rules.missing_resource_policy == block AND equipment_group unresolved",
        "severity":"critical"
      },
      {
        "rule_id":"BLOCK_DANGLING_NEXT_STEP",
        "condition":"next_steps[].step_no not found in steps[].step_no",
        "severity":"critical"
      },
      {
        "rule_id":"BLOCK_GRAPH_INCOMPLETE",
        "condition":"graph_completeness_status in [incomplete, blocked]",
        "severity":"critical"
      },
      {
        "rule_id":"BLOCK_UNRESOLVED_PROCESSING_TIME",
        "condition":"std_time_per unresolved AND std_speed unresolved",
        "severity":"critical"
      }
    ],
    "provisional_acceptance_rules":[
      {
        "rule_id":"ALLOW_PROVISIONAL_STEP",
        "condition":"compile_request.compile_policies.allow_provisional_steps == true",
        "required_flags":[
          "schema_status=provisional",
          "validation_report.notes_present"
        ]
      },
      {
        "rule_id":"ALLOW_PROVISIONAL_RECIPE_SCOPE",
        "condition":"compile_request.compile_policies.allow_provisional_recipe_scope == true"
      },
      {
        "rule_id":"ALLOW_ASSUME_ZERO_DEFECT",
        "condition":"runtime.scenario_toggles.enable_defect_generation == false"
      }
    ],
    "compile_output_contract":{
      "compiled_graph_object":{
        "required_sections":[
          "nodes",
          "transitions",
          "resource_bindings",
          "processing_time_plan",
          "queue_plan"
        ]
      },
      "validation_report":{
        "required_sections":[
          "blocking_errors",
          "warnings",
          "applied_normalizations",
          "derived_recomputations",
          "provisional_acceptances"
        ]
      },
      "runtime_echo":{
        "required":true
      }
    }
  }
}