DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ls_process_simulation
APP_ENV=local
LOG_LEVEL=info

# Required only for POST /ingestion/jobs/* (LLM-assisted extraction). Everything else works without it.
ANTHROPIC_API_KEY=

# Used only by tests/conftest.py (create this database once via psql/CREATE DATABASE); not read by the app itself.
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ls_process_simulation_test
